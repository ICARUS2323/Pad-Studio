<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PadStudio</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets/pad-studio.ico</ApplicationIcon>
    <RootNamespace>PadStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/pad-studio.png" />
    <Resource Include="Assets/pad-studio.ico" />
    <Content Include="../vendor/Interception/Interception/library/x64/interception.dll" Link="interception.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../vendor/Interception/Interception/command line installer/install-interception.exe" Link="driver/install-interception.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../vendor/Interception/Interception/licenses/non-commercial-usage/LGPL 3.0.txt" Link="licenses/Interception-LGPL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY.md" Link="licenses/THIRD-PARTY.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
