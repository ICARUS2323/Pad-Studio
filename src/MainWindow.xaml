<Window x:Class="PadStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Pad Studio" Width="1330" Height="900" MinWidth="1180" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid ClipToBounds="True">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0.48"><Ellipse Width="720" Height="650" Canvas.Left="220" Canvas.Top="-330" Fill="{DynamicResource Glow}"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse><Ellipse Width="500" Height="550" Canvas.Right="-210" Canvas.Bottom="-200" Fill="{DynamicResource Glow}"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse></Canvas>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="22,28,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Image Source="/Assets/pad-studio.png" Width="72" Height="72" HorizontalAlignment="Left" Margin="-5,-5,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock Text="Pad Studio" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,4"/>
     <TextBlock Text="Küçük tuşlar. Büyük işler." Foreground="{DynamicResource Muted}" FontSize="11"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,38,0,0">
     <Border Background="{DynamicResource Selection}" CornerRadius="8" Padding="13,12"><TextBlock Text="▦   Tuş düzenim" Foreground="{DynamicResource Text}" FontWeight="SemiBold"/></Border>
     <Button Content="⚙   Cihaz ve ayarlar" Click="Settings_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,9,0,0" Padding="13,12"/>
     <TextBlock Text="ÇALIŞMA ALANI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="12,32,0,12"/>
     <TextBlock Text="●  Genel düzen" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
     <TextBlock Text="18 özelleştirilebilir tuş" Foreground="{DynamicResource Muted}" FontSize="11" Margin="24,8,0,0"/>
    </StackPanel>
    <Border Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="10" Padding="13">
     <StackPanel><TextBlock Text="HER ŞEY SENİN ELİNDE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Mint}"/><TextBlock Text="Bir tuş seç.&#x0a;İşini kolaylaştır." FontSize="15" FontWeight="SemiBold" Margin="0,9,0,12"/><Button Content="Düzeni dışa aktar ↗" Click="Export_Click" FontSize="11" Padding="8,9" Background="Transparent"/></StackPanel>
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ClipToBounds="True">
    <StackPanel><TextBlock Text="KÜÇÜK TUŞLAR. BÜYÜK İŞLER." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Her tuşa bir görev." FontSize="32" FontWeight="SemiBold" Margin="0,7,0,7"/><TextBlock Text="Uygulamalar, kısayollar ve aklındaki bütün küçük kolaylıklar." Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
    <Button x:Name="ActiveButton" Content="▷  Etkinleştir" Click="Active_Click" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="155"/>
   </Grid>
   <Border Grid.Row="1" x:Name="DeviceBanner" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="18" Padding="18,14" Margin="0,23,0,20">
    <Grid ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DeviceTitle" Text="Numpadini bağlayalım" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="DeviceSubtitle" Text="Ana klavyeden bağımsız kullanım için cihaz kurulumu gerekli." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="PairButton" Grid.Column="1" Content="Cihazı tanıt →" Click="Pair_Click" Padding="12,8" FontSize="12" VerticalAlignment="Center"/></Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.13*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource GlassCard}" Padding="24,23,24,20">
     <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ClipToBounds="True"><StackPanel><TextBlock Text="Senin numpad'in" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Düzenlemek için bir tuşa tıkla." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Background="{DynamicResource Selection}" CornerRadius="6" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="AssignedCount" Text="3 / 18" FontSize="10" Foreground="{DynamicResource Accent}"/></Border></Grid>
      <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="470" Margin="0,20,0,16">
       <Border Background="{DynamicResource TraySurface}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="23" Padding="11"><Grid x:Name="PadGrid" Width="380" Height="455"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid></Border>
      </Viewbox>
      <TextBlock Grid.Row="2" Text="HIZLI BAŞLANGIÇ" FontSize="9" Foreground="{DynamicResource Muted}" FontWeight="Bold" Margin="0,0,0,9"/>
      <UniformGrid Grid.Row="3" Columns="3"><Button Content="⌘  Kopyala" Click="PresetCopy_Click" FontSize="11" Padding="4,9" Margin="0,0,6,0"/><Button Content="↗  Uygulama" Click="PresetApp_Click" FontSize="11" Padding="4,9" Margin="0,0,6,0"/><Button Content="◎  Web sitesi" Click="PresetWeb_Click" FontSize="11" Padding="4,9"/></UniformGrid>
     </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="24,23,24,20">
     <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ClipToBounds="True"><StackPanel><TextBlock Text="TUŞ DÜZENLEYİCİ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SelectedTitle" Text="1 tuşu" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><Border Background="{DynamicResource Selection}" CornerRadius="8" Padding="13,8" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="SelectedBadge" Text="1" Foreground="{DynamicResource Accent}" FontSize="20" FontWeight="SemiBold"/></Border></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,10" Padding="0,0,6,0">
       <StackPanel>
        <TextBlock Text="GÖREV ADI" Style="{StaticResource Label}"/><TextBox x:Name="TitleBox" MaxLength="40" TextChanged="Editor_Changed"/>
        <TextBlock Text="NE YAPSIN?" Style="{StaticResource Label}"/><ComboBox x:Name="KindBox" SelectionChanged="Kind_Changed"/>
        <StackPanel x:Name="TargetPanel"><TextBlock x:Name="TargetLabel" Text="HEDEF" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TargetBox" TextChanged="Editor_Changed"/><Button x:Name="BrowseButton" Grid.Column="1" Content="…" Click="Browse_Click" Margin="7,0,0,0" Padding="12,6"/></Grid></StackPanel>
        <StackPanel x:Name="ArgumentsPanel"><TextBlock Text="BAŞLATMA PARAMETRELERİ (İSTEĞE BAĞLI)" Style="{StaticResource Label}"/><TextBox x:Name="ArgumentsBox" TextChanged="Editor_Changed"/><TextBlock Text="ÇALIŞMA KLASÖRÜ (İSTEĞE BAĞLI)" Style="{StaticResource Label}"/><TextBox x:Name="WorkingBox" TextChanged="Editor_Changed"/></StackPanel>
        <StackPanel x:Name="TextPanel"><TextBlock Text="YAZILACAK METİN" Style="{StaticResource Label}"/><TextBox x:Name="TextContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="115" MaxLength="10000" VerticalScrollBarVisibility="Auto" TextChanged="Editor_Changed"/></StackPanel>
        <StackPanel x:Name="MediaPanel"><TextBlock Text="MEDYA İŞLEMİ" Style="{StaticResource Label}"/><ComboBox x:Name="MediaBox" SelectionChanged="Media_Changed"/></StackPanel>
        <StackPanel x:Name="MacroPanel"><Grid Margin="0,19,0,8"><TextBlock Text="MAKRO ADIMLARI" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="StepCount" HorizontalAlignment="Right" Text="1 adım" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid><ListBox x:Name="StepList" Height="143" DisplayMemberPath="Description"/><Button Content="⌨  Klavyeden makro oluştur" Click="Macro_Click" Margin="0,10,0,0" Padding="9,11" Foreground="{DynamicResource Accent}" Background="{DynamicResource Selection}"/><TextBlock Text="Birlikte basılacak tuşları seç veya adım adım bir dizi oluştur." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
        <TextBlock x:Name="EditorHint" Text="Bu görev aktif uygulamada çalışır." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,4"/>
       </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Kaydet" Click="Save_Click" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button Grid.Column="1" x:Name="TestButton" Content="Dene" Click="Test_Click" Padding="13,10" Margin="0,0,8,0" ToolTip="3 saniye içinde hedef uygulamaya geç."/><Button Grid.Column="2" Content="Sil" Click="Clear_Click" Padding="13,10"/></Grid>
     </Grid>
    </Border>
   </Grid>
   <Border Grid.Row="3" Margin="0,17,0,0" Padding="2,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Mint}" Margin="0,0,9,0"/><TextBlock Grid.Column="1" x:Name="StatusText" Text="Hazır. İlk görevini özelleştir." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="PAD STUDIO  /  0.3.0" Foreground="{DynamicResource Muted}" FontSize="9" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Grid>
</Window>

