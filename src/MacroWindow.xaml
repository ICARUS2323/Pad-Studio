<Window x:Class="PadStudio.MacroWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Makro oluştur · Pad Studio" Width="1110" Height="860" MinWidth="1020" MinHeight="810" WindowStartupLocation="CenterOwner">
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="KLAVYE MAKROSU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Tuşları seç. Akışı oluştur." FontSize="26" FontWeight="SemiBold" Margin="0,7,0,7"/><TextBlock Text="Kopyalamak için Ctrl ve C'yi birlikte ekle. Ardışık işlemler için yeni adımlar ekle." FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel><Border Background="{DynamicResource Selection}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="TÜRKÇE Q" FontSize="10" Foreground="{DynamicResource Accent}"/></Border></Grid>
  <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,20,0,12"><StackPanel x:Name="KeyboardPanel"/></Border>
  <Grid Grid.Row="2" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Input}" CornerRadius="8" Padding="12,11" Margin="0,0,10,0"><TextBlock x:Name="SelectedKeysText" Text="Klavyeden tuş seç…" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/></Border><ComboBox x:Name="ModeBox" Grid.Column="1" SelectedIndex="0" Margin="0,0,10,0"><ComboBoxItem Content="Aynı anda bas" Foreground="{DynamicResource Text}"/><ComboBoxItem Content="Sırayla bas" Foreground="{DynamicResource Text}"/></ComboBox><Button Grid.Column="2" Content="+ Tuşları ekle" Click="AddKeys_Click" Style="{StaticResource Primary}"/></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,9"><TextBlock Text="ÇALIŞMA SIRASI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}"/></Grid><ListBox Grid.Row="1" x:Name="StepsList" DisplayMemberPath="Description" SelectionChanged="Step_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,9,0,0"><Button Content="↑" Click="MoveUp_Click" Padding="13,7" Margin="0,0,6,0"/><Button Content="↓" Click="MoveDown_Click" Padding="13,7" Margin="0,0,6,0"/><Button Content="Sil" Click="Remove_Click" Padding="13,7" Margin="0,0,6,0"/><Button Content="Seçili adımı güncelle" Click="UpdateStep_Click" Padding="12,7" FontSize="11"/></StackPanel></Grid>
   <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="11" Padding="17,13"><StackPanel><TextBlock Text="ADIMLAR ARASINA EKLE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DelayBox" Text="300" ToolTip="Milisaniye cinsinden bekleme: 1000 ms = 1 saniye"/><Button Grid.Column="1" Content="+ Bekleme (ms)" Click="AddDelay_Click" Margin="8,0,0,0" FontSize="11" Padding="12,8"/></Grid><TextBox x:Name="StepTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="42" MaxLength="10000" VerticalScrollBarVisibility="Auto"/><Button Content="+ Metin yazma adımı" Click="AddText_Click" Margin="0,8,0,0" FontSize="11" Padding="10,8" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="4" Margin="0,20,0,0"><TextBlock Text="Adımlar yukarıdan aşağıya bir kez çalışır." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vazgeç" Click="Cancel_Click" Margin="0,0,9,0"/><Button Content="Makroyu uygula" Click="Apply_Click" Style="{StaticResource Primary}" MinWidth="160"/></StackPanel></Grid>
 </Grid>
</Window>

